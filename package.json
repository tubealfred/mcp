{
  "name": "@tubealfred/mcp",
  "version": "0.1.5",
  "description": "TubeAlfred YouTube MCP server. Stdio bridge to the hosted streamable-HTTP MCP at mcp.tubealfred.com — install in Claude Desktop, Cursor, Continue, or any MCP client.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "bin": {
    "tubealfred-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:dxt": "pnpm build && node dxt/build.mjs",
    "dev": "tsup --watch",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "youtube",
    "tubealfred",
    "claude",
    "cursor"
  ],
  "homepage": "https://tubealfred.com/mcp",
  "bugs": {
    "url": "https://github.com/tubealfred/mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tubealfred/mcp.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "archiver": "^7.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
